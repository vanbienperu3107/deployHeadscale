# Caddy chi phuc vu DUY NHAT ten mien cliproxy.hangocthanh.io.vn, nam sau nginx.
#
# Caddy nghe 8444 (khong publish ra host). nginx nhan 443, thay SNI la
# cliproxy.hangocthanh.io.vn thi noi TCP toi day, Caddy terminate TLS.
{
	# Khong mo API quan tri (mac dinh 2019) — stack nay khong dung toi.
	admin off
	# Cong 80 cua host thuoc ve derper (ACME HTTP-01 cua no) nen Caddy KHONG the
	# dung http challenge. TLS-ALPN chay ngay tren cong 8444 nay, va nginx da
	# chuyen tiep dung SNI toi day nen Let's Encrypt van bat tay duoc.
	auto_https disable_redirects

	# CHI cong 8445 (opencode) nhan PROXY protocol tu chang 2 cua nginx — de log
	# ra IP THAT cua client cho fail2ban. 8444 (cliproxy) giu nguyen khong PROXY
	# protocol; bat nham o day thi moi ket noi cu (khong gui header) se hong.
	servers :8445 {
		listener_wrappers {
			proxy_protocol {
				timeout 5s
				# Chi tin header PROXY tu nginx trong mang docker edge (172.x)
				allow 172.16.0.0/12
			}
			tls
		}
	}
}

https://cliproxy.hangocthanh.io.vn:8444 {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}

	# Chan truy cap khong co API key ngay tu day thi khong duoc: CLIProxyAPI tu
	# xac thuc bang api-keys va tra 401. Caddy chi chuyen tiep.
	reverse_proxy cliproxy:8317 {
		# Tra loi cua LLM la SSE — phai day tung chunk ra ngay, khong dem.
		# Thieu dong nay thi client "dung hinh" cho toi khi ket thuc phan hoi.
		flush_interval -1

		# Phan hoi dai (sinh code) co the mat vai phut; khong dat read timeout.
		transport http {
			dial_timeout 10s
		}
	}

	log {
		output stdout
		format console
	}
}

# opencode-server da tu xac thuc bang HTTP Basic (OPENCODE_SERVER_PASSWORD) va tra
# 401 cho MOI duong dan ke ca /global/health, /doc — xem memory opencode-api-do-duoc.
# Caddy o day CHI chuyen tiep, khong lam lop xac thuc thu hai.
#
# CANH BAO: opencode-server duoc phep chay `bash` va sua file trong workspace. Lo no
# ra Internet la trao ca duong tan cong brute-force mat khau Basic. Domain rieng nay
# KHONG dung chung port 8444 voi cliproxy de mot site loi khong keo site kia sap.
https://opencode.hangocthanh.io.vn:8445 {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}

	reverse_proxy opencode-server:4096 {
		# /event la SSE dai han (long-lived), khong duoc dem.
		flush_interval -1

		transport http {
			dial_timeout 10s
		}
	}

	# Ghi RA FILE (khong chi stdout) de container fail2ban doc duoc qua volume
	# chung — fail2ban khong doc duoc docker stdout cua container khac. File nay
	# CHI chua log cua site opencode nen moi dong 401 trong do deu la ung vien ban.
	log {
		output file /var/log/caddy/opencode-access.log {
			roll_size 10MiB
			roll_keep 3
		}
		format json
	}
}
